const { spawnSync } = require('node:child_process');

const ROOT = process.cwd();
const PACKAGE_JSON = path.join(ROOT, 'package.json');
const LOCK_FILE = path.join(ROOT, 'package-lock.json');
const TARGET_VERSION = '1.2.8';

function log(message) {
  console.log(`[minimist-updater] ${message}`);
}

function fail(message) {
  console.error(`[minimist-updater] ERRO: ${message}`);
  process.exitCode = 1;
}

function run(command, args) {
  log(`Executando: ${command} ${args.join(' ')}`);

  const result = spawnSync(command, args, {
    cwd: ROOT,
    encoding: 'utf8',
    stdio: 'inherit',
    shell: process.platform === 'win32',
  });

  if (result.error) {
    throw result.error;
  }

  if (result.status !== 0) {
    throw new Error(
      `O comando terminou com código ${result.status}.`,
    );
  }
}

function backup(filePath) {
  if (!fs.existsSync(filePath)) {
    throw new Error(`Arquivo não encontrado: ${filePath}`);
  }

  const backupPath = `${filePath}.backup`;

  if (fs.existsSync(backupPath)) {
    throw new Error(
      `O backup já existe: ${backupPath}. ` +
      'Renomeie-o ou guarde-o antes de continuar.',
    );
  }

  fs.copyFileSync(filePath, backupPath);
  log(`Backup criado: ${path.basename(backupPath)}`);
}

function validateFiles() {
  for (const filePath of [PACKAGE_JSON, LOCK_FILE]) {
    if (!fs.existsSync(filePath)) {
      throw new Error(
        `Arquivo obrigatório não encontrado: ${path.basename(filePath)}`,
      );
    }
  }

  JSON.parse(fs.readFileSync(PACKAGE_JSON, 'utf8'));
  JSON.parse(fs.readFileSync(LOCK_FILE, 'utf8'));

  log('package.json e package-lock.json são JSON válidos.');
}

function inspectMinimist() {
  const lock = JSON.parse(fs.readFileSync(LOCK_FILE, 'utf8'));
  const found = [];

  if (lock.packages && typeof lock.packages === 'object') {
    for (const [name, data] of Object.entries(lock.packages)) {
      if (
        name === 'node_modules/minimist' ||
        name.endsWith('/node_modules/minimist')
      ) {
        found.push({
          location: name,
          version: data.version ?? 'desconhecida',
        });
      }
    }
  } else {
    function visit(dependencies, parent = '') {
      for (const [name, data] of Object.entries(dependencies ?? {})) {
        const location = parent ? `${parent} > ${name}` : name;

        if (name === 'minimist') {
          found.push({
            location,
            version: data.version ?? 'desconhecida',
          });
        }

        visit(data.dependencies, location);
      }
    }

    visit(lock.dependencies);
  }

  if (found.length === 0) {
    log('Nenhuma entrada de minimist foi encontrada no lockfile.');
    return false;
  }

  console.log('\nVersões de minimist no package-lock.json:');

  for (const item of found) {
    console.log(`- ${item.location}: ${item.version}`);
  }

  const targetFound = found.some(
    (item) => item.version === TARGET_VERSION,
  );

  if (!targetFound) {
    log(`A versão ${TARGET_VERSION} ainda não aparece no lockfile.`);
  }

  return targetFound;
}

function main() {
  try {
    validateFiles();

    const packageData = JSON.parse(
      fs.readFileSync(PACKAGE_JSON, 'utf8'),
    );

    if (!packageData.name) {
      log('Aviso: package.json não declara o nome do projeto.');
    }

    backup(PACKAGE_JSON);
    backup(LOCK_FILE);

    // Atualiza o lockfile usando o resolvedor oficial do npm.
    run('npm', [
      'install',
      '--package-lock-only',
      '--ignore-scripts',
    ]);

    // Atualiza minimist respeitando as restrições de versão existentes.
    run('npm', [
      'update',
      'minimist',
      '--package-lock-only',
      '--ignore-scripts',
    ]);

    const targetFound = inspectMinimist();

    log('Verificando a árvore de dependências...');
    run('npm', ['ls', 'minimist', '--all']);

    log('Executando auditoria de segurança do npm...');
    run('npm', ['audit']);

    if (!targetFound) {
      throw new Error(
        `Não foi possível confirmar minimist ${TARGET_VERSION}. ` +
        'Verifique as restrições de versão e as dependências do projeto.',
      );
    }

    log('Atualização e verificações concluídas.');
    log('Revise as alterações antes de confirmar no Git.');
  } catch (error) {
    fail(error.message);
    log(
      'Os backups foram preservados. Se houver falha, revise os arquivos ' +
      'antes de restaurar manualmente.',
    );
  }
}

main();
